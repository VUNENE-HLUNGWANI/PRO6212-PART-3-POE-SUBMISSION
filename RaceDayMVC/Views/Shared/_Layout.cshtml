@using System.Linq
@{
    var userId = Context.Session.GetInt32("UserId");
    var role = (Context.Session.GetString("Role") ?? string.Empty).Trim();
    var isLoggedIn = userId.HasValue;
    var isOrganiser = string.Equals(role, "Organiser", StringComparison.OrdinalIgnoreCase);
    var isParticipant = string.Equals(role, "Participant", StringComparison.OrdinalIgnoreCase);

    var themeKey = !isLoggedIn ? "guest"
        : isOrganiser ? "organiser"
        : isParticipant ? "participant"
        : "guest";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var isLanding = currentController == "Home" && currentAction == "Index";
    var isEvents = currentController == "Events";
    var isEnrolments = currentController == "MyEnrolments";
    var isResults = currentController == "MyResults";
    var isProfile = currentController == "Profile";
    var isCategories = currentController == "Categories";
    var isCreate = currentController == "Organiser" && currentAction == "Create";
    var isRegister = currentController == "Auth" && currentAction == "Register";
    var isPrivacy = currentController == "Home" && currentAction == "Privacy";
    var isDashboard = currentController == "Organiser" && !isCreate;
    var isAuth = currentController == "Auth" && !isRegister;

    var allItems = new List<(string Key, string Label, string Controller, string Action, string Needs, bool Active)>
    {
        ("home", "Home", "Home", "Index", "", currentController == "Home" && currentAction == "Index"),
        ("events", "Events", "Events", "Index", "", isEvents),
        ("privacy", "Privacy", "Home", "Privacy", "", isPrivacy),
        ("enrolments", "My enrolments", "MyEnrolments", "Index", "Participant", isEnrolments),
        ("results", "My results", "MyResults", "Index", "Participant", isResults),
        ("dashboard", "Dashboard", "Organiser", "Index", "Organiser", isDashboard),
        ("create", "Create event", "Organiser", "Create", "Organiser", isCreate),
        ("categories", "Categories", "Categories", "Index", "Organiser", isCategories),
        ("profile", "Profile", "Profile", "Index", "Any", isProfile),
        ("login", "Log in", "Auth", "Login", "Guest", isAuth && currentAction == "Login"),
        ("register", "Create account", "Auth", "Register", "Guest", isRegister)
    };

    var visibleItems = new List<(string Key, string Label, string Controller, string Action, bool Locked, bool Active)>();

    foreach (var item in allItems)
    {
        if (item.Needs == "Guest")
        {
            if (!isLoggedIn)
            {
                visibleItems.Add((item.Key, item.Label, item.Controller, item.Action, false, item.Active));
            }
            continue;
        }

        if (!isLoggedIn)
        {
            visibleItems.Add((item.Key, item.Label, item.Controller, item.Action, item.Needs != "", item.Active));
            continue;
        }

        if (item.Needs == ""
            || item.Needs == "Any"
            || (item.Needs == "Participant" && isParticipant)
            || (item.Needs == "Organiser" && isOrganiser))
        {
            visibleItems.Add((item.Key, item.Label, item.Controller, item.Action, false, item.Active));
        }
    }

    if (isLoggedIn)
    {
        visibleItems.Add(("logout", "Log out", "Auth", "Logout", false, false));
    }

    var hasActive = visibleItems.Any(i => i.Active);
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;

    var commandItems = new List<(string Key, string Label, string Controller, string Action, string Group)>();
    foreach (var item in visibleItems)
    {
        if (item.Key == "logout") { continue; }
        var group = item.Key switch
        {
            "home" or "events" or "privacy" => "Explore",
            "enrolments" or "results" or "profile" => "Your account",
            "dashboard" or "create" or "categories" => "Organiser",
            "login" or "register" => "Account",
            _ => "Go"
        };
        commandItems.Add((item.Key, item.Label, item.Controller, item.Action, group));
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05040f" />

    <title>@(ViewData["Title"] ?? "RaceDay") | RaceDay</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="rd-body theme-@themeKey @(isLanding ? "is-landing" : "")">

    <a class="rd-skip" href="#main">Skip to content</a>

    <nav class="rd-float-nav @(hasActive ? "" : "no-notch")" aria-label="Main navigation" data-header>
        <div class="rd-float-bar">
            <ul class="rd-float-list">

                @foreach (var item in visibleItems)
                {
                    <li class="rd-float-item">
                        @if (item.Key == "logout")
                        {
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="rd-float-form"
                                  data-confirm="Are you sure you want to log out?">
                                <button type="submit" class="rd-float-link">
                                    <span class="rd-float-bubble">
                                        @await Html.PartialAsync("_NavIcon", item.Key)
                                    </span>
                                    <span class="rd-float-label">@item.Label</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="rd-float-link @(item.Active ? "is-active" : "") @(item.Locked ? "is-locked" : "")"
                               href="@(item.Locked ? Url.Action("Login", "Auth") : Url.Action(item.Action, item.Controller))"
                               aria-current="@(item.Active ? "page" : "false")"
                               title="@(item.Locked ? "Log in to open " + item.Label : item.Label)">
                                <span class="rd-float-bubble">
                                    @await Html.PartialAsync("_NavIcon", item.Key)
                                </span>
                                <span class="rd-float-label">@item.Label</span>
                            </a>
                        }
                    </li>
                }

                <li class="rd-float-item" aria-hidden="false">
                    <button type="button" class="rd-float-link" data-cmdk-open aria-label="Open command palette (Ctrl K)">
                        <span class="rd-float-bubble">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="11" cy="11" r="7" />
                                <path d="M20 20l-3.5-3.5" />
                            </svg>
                        </span>
                        <span class="rd-float-label">Search</span>
                    </button>
                </li>

            </ul>
        </div>
    </nav>

    <main id="main" class="rd-main">

        @if (successMessage != null || errorMessage != null)
        {
            <div class="rd-wrap rd-flash">
                @if (successMessage != null)
                {
                    <div class="rd-alert rd-alert-success" role="status">@successMessage</div>
                }
                @if (errorMessage != null)
                {
                    <div class="rd-alert rd-alert-error" role="alert">@errorMessage</div>
                }
            </div>
        }

        @if (isLanding)
        {
            @RenderBody()
        }
        else
        {
            <div class="rd-wrap rd-page">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="rd-footer">
        <div class="rd-wrap">
            <div class="rd-footer-grid">
                <div>
                    <a class="rd-brand" asp-controller="Home" asp-action="Index">
                        <span class="rd-brand-mark">R</span>
                        <span>RACE<em>DAY</em></span>
                    </a>
                    <p class="mt-3 mb-0">
                        Road race management for runners, walkers and cyclists.
                        Browse events, enrol in the right category and follow
                        your results.
                    </p>
                </div>

                <div>
                    <p class="rd-footer-title">Explore</p>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Events" asp-action="Index">Events</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>

                <div>
                    <p class="rd-footer-title">Account</p>
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Profile" asp-action="Index">Profile</a>
                        @if (isParticipant)
                        {
                            <a asp-controller="MyEnrolments" asp-action="Index">My enrolments</a>
                            <a asp-controller="MyResults" asp-action="Index">My results</a>
                        }
                        @if (isOrganiser)
                        {
                            <a asp-controller="Organiser" asp-action="Index">Dashboard</a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login">Log in</a>
                        <a asp-controller="Auth" asp-action="Register">Create account</a>
                    }
                </div>
            </div>

            <div class="rd-footer-base">
                <span>&copy; @DateTime.Now.Year RaceDay</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <button type="button" class="rd-to-top" data-to-top aria-label="Back to top">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <!-- Command palette -->
    <div class="rd-cmdk" data-cmdk aria-hidden="true" role="dialog" aria-label="Command palette">
        <div class="rd-cmdk-panel" role="document">
            <div class="rd-cmdk-search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                <input class="rd-cmdk-input" type="text" placeholder="Search pages, events, actions…" aria-label="Search" autocomplete="off" spellcheck="false" />
                <span class="rd-cmdk-kbd">ESC</span>
            </div>

            <ul class="rd-cmdk-list" data-cmdk-list role="listbox">
                @foreach (var item in commandItems)
                {
                    <li class="rd-cmdk-item" data-cmdk-item
                        data-cmdk-search="@item.Label @item.Group"
                        role="option" aria-selected="false">
                        <a href="@Url.Action(item.Action, item.Controller)" class="d-flex align-items-center gap-3 text-decoration-none text-reset w-100" style="padding: 0; margin: 0;">
                            <span class="rd-cmdk-ico">
                                @await Html.PartialAsync("_NavIcon", item.Key)
                            </span>
                            <span class="rd-cmdk-item-label">@item.Label</span>
                            <span class="rd-cmdk-item-group">@item.Group</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="rd-cmdk-empty" data-cmdk-empty hidden>
                No matches. Try "events", "profile" or "privacy".
            </div>

            <div class="rd-cmdk-foot">
                <span><span class="rd-cmdk-kbd">↑</span> <span class="rd-cmdk-kbd">↓</span> to navigate</span>
                <span><span class="rd-cmdk-kbd">↵</span> to select</span>
            </div>
        </div>
    </div>

    <script>
            (function () {
                var bar = document.querySelector('.rd-float-bar');
                var active = document.querySelector('.rd-float-link.is-active');
                if (!bar || !active) { return; }
                function placeNotch() {
                    bar.style.setProperty('--notch-x',
                        (active.offsetLeft + active.offsetWidth / 2) + 'px');
                }
                placeNotch();
                window.addEventListener('load', placeNotch);
                window.addEventListener('resize', placeNotch);
            })();
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>