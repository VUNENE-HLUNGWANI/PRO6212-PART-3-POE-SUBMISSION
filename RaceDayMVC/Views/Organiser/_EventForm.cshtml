@model RaceDayMVC.Models.CreateEventViewModel
@{
    var editModel = Model as RaceDayMVC.Models.EditEventViewModel;
    var isEdit = editModel != null;
    var submitText = isEdit ? "Save changes" : "Publish event";
    var noFileText = isEdit ? "Keep current banner" : "No banner";
}

<div asp-validation-summary="ModelOnly" class="rd-validation-summary rd-alert rd-alert-error"></div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" novalidate data-wizard>
    @if (editModel != null)
    {
        <input type="hidden" name="EventId" value="@editModel.EventId" />
    }

    <ol class="rd-stepper">
        <li data-step-label>Details</li>
        <li data-step-label>Schedule</li>
        <li data-step-label>Review</li>
    </ol>

    <section data-step>
        <div class="rd-form-grid">
            <div class="rd-field-full">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="150" required data-label="Event name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="EventType" class="form-label"></label>
                <input asp-for="EventType" class="form-control" maxlength="50" list="rdEventTypes" required data-label="Event type" />
                <datalist id="rdEventTypes">
                    <option value="Road race"></option>
                    <option value="Trail run"></option>
                    <option value="Cycling"></option>
                    <option value="Triathlon"></option>
                    <option value="Fun run"></option>
                </datalist>
                <span asp-validation-for="EventType" class="field-validation-error"></span>
            </div>

            <div>
                <label class="form-label" for="BannerImage">Banner image</label>
                <input type="file" id="BannerImage" name="BannerImage" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" data-label="Banner image"
                       data-empty-text="@noFileText" />
                <div class="rd-hint">JPG, PNG or WebP, up to 5 MB.</div>
            </div>

            <div class="rd-field-full">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="500" required data-label="Description"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(editModel?.CurrentBannerUri))
        {
            <div class="mt-3">
                <div class="rd-label mb-1">Current banner</div>
                <img class="rd-banner-preview" src="@editModel.CurrentBannerUri" alt="Current banner" />
            </div>
        }
    </section>

    <section data-step>
        <div class="rd-form-grid">
            <div>
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" required data-label="Event date" />
                <span asp-validation-for="Date" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="time" class="form-control" required data-label="Start time" />
                <span asp-validation-for="StartTime" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" maxlength="150" required data-label="Location" />
                <span asp-validation-for="Location" class="field-validation-error"></span>
            </div>

            <div>
                <label asp-for="Distance" class="form-label"></label>
                <input asp-for="Distance" type="number" step="0.1" min="0.1" max="1000" class="form-control" required data-label="Distance (km)" />
                <span asp-validation-for="Distance" class="field-validation-error"></span>
            </div>

            <div class="rd-field-full">
                <label asp-for="Routemap" class="form-label"></label>
                <input asp-for="Routemap" class="form-control" maxlength="255" required
                       placeholder="Link to the route map or a short description" data-label="Route map" />
                <span asp-validation-for="Routemap" class="field-validation-error"></span>
            </div>

            <div class="rd-field-full">
                <label asp-for="RegistrationDeadline" class="form-label"></label>
                <input asp-for="RegistrationDeadline" type="datetime-local" class="form-control" required data-label="Registration deadline" />
                <span asp-validation-for="RegistrationDeadline" class="field-validation-error"></span>
            </div>
        </div>
    </section>

    <section data-step>
        <p class="rd-muted mb-3">Check the summary below. Use Back to change anything.</p>
        <dl class="rd-dl rd-review" data-review></dl>
    </section>

    <div class="rd-wizard-actions">
        <button type="button" class="rd-btn rd-btn-outline" data-prev hidden>Back</button>
        <div>
            <button type="button" class="rd-btn rd-btn-primary" data-next>Next</button>
            <button type="submit" class="rd-btn rd-btn-accent" data-submit hidden>@submitText</button>
        </div>
    </div>
</form>