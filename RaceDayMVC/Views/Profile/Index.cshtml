@model RaceDayMVC.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var firstName = Model.FirstName ?? string.Empty;
    var lastName = Model.LastName ?? string.Empty;

    var isParticipant = string.Equals(
        Model.Role, "Participant",
        StringComparison.OrdinalIgnoreCase);

    var isOrganiser = string.Equals(
        Model.Role, "Organiser",
        StringComparison.OrdinalIgnoreCase);

    var initials =
        (firstName.Length > 0 ? firstName.Substring(0, 1) : "") +
        (lastName.Length > 0 ? lastName.Substring(0, 1) : "");
}

<div class="rd-page-header">
    <div>
        <p class="rd-eyebrow">ACCOUNT SETTINGS</p>
        <h1 class="rd-title">My Profile</h1>
        <p class="rd-subtitle">
            Manage your personal information and keep your account details up to date.
        </p>
    </div>

    <div class="rd-header-actions">
        <a class="rd-btn rd-btn-ghost" href="@Url.Action("Index", "Home")">Back to home</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="rd-alert rd-alert-success mb-4" role="alert">
        <strong>Success!</strong> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="rd-alert rd-alert-error mb-4" role="alert">
        @TempData["Error"]
    </div>
}

<div class="row g-4">

    <!-- PROFILE SUMMARY -->
    <div class="col-lg-4">
        <div class="rd-card h-100">
            <div class="rd-card-body text-center p-4">

                <div class="rd-avatar mx-auto mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUri))
                    {
                        <img src="@Model.ProfilePictureUri"
                             alt="Profile picture"
                             id="currentProfilePicture" />
                    }
                    else
                    {
                        @initials.ToUpperInvariant()
                    }
                </div>

                <h2 class="rd-card-title mb-2">
                    @firstName @lastName
                </h2>

                <span class="rd-badge rd-badge-soft">
                    @Model.Role
                </span>

                <p class="rd-muted small mt-3 mb-1">
                    @Model.Email
                </p>

                <hr class="my-4" />

                <div class="text-start">
                    <p class="rd-eyebrow">ACCOUNT INFORMATION</p>

                    <div class="mb-3">
                        <small class="rd-muted d-block">Account type</small>
                        <strong>@Model.Role</strong>
                    </div>

                    <div class="mb-3">
                        <small class="rd-muted d-block">Email address</small>
                        <strong class="text-break">@Model.Email</strong>
                    </div>

                    <div>
                        <small class="rd-muted d-block">Phone number</small>
                        <strong>@Model.PhoneNumber</strong>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- EDIT PROFILE -->
    <div class="col-lg-8">
        <div class="rd-card">
            <div class="rd-card-body p-4 p-lg-5">

                <div class="mb-4">
                    <p class="rd-eyebrow">PROFILE MANAGEMENT</p>
                    <h2 class="rd-card-title mb-1">
                        Edit your details
                    </h2>
                    <p class="rd-muted small mb-0">
                        Update your information below and save your changes.
                    </p>
                </div>

                <div asp-validation-summary="All"
                     class="rd-validation-summary rd-alert rd-alert-error mb-4">
                </div>

                <form asp-controller="Profile"
                      asp-action="Update"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="UserID" />
                    <input type="hidden" asp-for="Role" />

                    <!-- PERSONAL DETAILS -->
                    <h3 class="rd-card-title mb-3">
                        Personal Details
                    </h3>

                    <div class="rd-form-grid mb-4">

                        <div>
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName"
                                   class="form-control"
                                   required />
                            <span asp-validation-for="FirstName"
                                  class="field-validation-error"></span>
                        </div>

                        <div>
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName"
                                   class="form-control"
                                   required />
                            <span asp-validation-for="LastName"
                                  class="field-validation-error"></span>
                        </div>

                        <div>
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   required />
                            <span asp-validation-for="PhoneNumber"
                                  class="field-validation-error"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   required
                                   autocomplete="email" />
                            <span asp-validation-for="Email"
                                  class="field-validation-error"></span>
                            <div class="rd-hint">
                                Your email address is also used to log in.
                            </div>
                        </div>

                        <div class="rd-field-full">
                            <label for="profilePicture" class="form-label">
                                Profile Picture
                            </label>

                            <input type="file"
                                   id="profilePicture"
                                   name="profilePicture"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                            <div class="rd-hint">
                                Upload a JPG, PNG or WebP image (maximum 5 MB).
                            </div>

                            <div id="picturePreviewContainer"
                                 class="mt-3"
                                 style="display:none;">
                                <img id="picturePreview"
                                     alt="Selected profile picture preview"
                                     style="width:90px;height:90px;object-fit:cover;border-radius:50%;" />
                            </div>
                        </div>

                    </div>

                    <!-- PARTICIPANT DETAILS -->
                    @if (isParticipant)
                    {
                        <hr class="my-4" />

                        <h3 class="rd-card-title mb-3">
                            Participant Details
                        </h3>

                        <p class="rd-muted small mb-3">
                            Your additional information helps organisers
                            manage your event participation.
                        </p>

                        <div class="rd-form-grid mb-4">

                            <div>
                                <label asp-for="DateOfBirth"
                                       class="form-label"></label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="DateOfBirth"
                                      class="field-validation-error"></span>
                            </div>

                            <div>
                                <label asp-for="Gender"
                                       class="form-label"></label>

                                <select asp-for="Gender"
                                        class="form-select"
                                        required>
                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                    <option value="Prefer not to say">
                                        Prefer not to say
                                    </option>
                                </select>

                                <span asp-validation-for="Gender"
                                      class="field-validation-error"></span>
                            </div>

                            <div>
                                <label asp-for="EmergencyContactName"
                                       class="form-label"></label>

                                <input asp-for="EmergencyContactName"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="EmergencyContactName"
                                      class="field-validation-error"></span>
                            </div>

                            <div>
                                <label asp-for="EmergencyContactNumber"
                                       class="form-label"></label>

                                <input asp-for="EmergencyContactNumber"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="EmergencyContactNumber"
                                      class="field-validation-error"></span>
                            </div>

                        </div>
                    }

                    <!-- ORGANISER DETAILS -->
                    @if (isOrganiser)
                    {
                        <hr class="my-4" />

                        <h3 class="rd-card-title mb-3">
                            Organisation Details
                        </h3>

                        <p class="rd-muted small mb-3">
                            Keep your organisation's contact information current.
                        </p>

                        <div class="rd-form-grid mb-4">

                            <div>
                                <label asp-for="OrganisationName"
                                       class="form-label"></label>

                                <input asp-for="OrganisationName"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="OrganisationName"
                                      class="field-validation-error"></span>
                            </div>

                            <div>
                                <label asp-for="OrganisationContact"
                                       class="form-label"></label>

                                <input asp-for="OrganisationContact"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="OrganisationContact"
                                      class="field-validation-error"></span>
                            </div>

                        </div>
                    }

                    <!-- SAVE ACTIONS -->
                    <hr class="my-4" />

                    <div class="rd-wizard-actions">
                        <span class="rd-muted small">
                            Your changes will be saved to your RaceDay account.
                        </span>

                        <button type="submit"
                                class="rd-btn rd-btn-primary">
                            Save Changes
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const pictureInput = document.getElementById("profilePicture");
        const preview = document.getElementById("picturePreview");
        const previewContainer =
            document.getElementById("picturePreviewContainer");

        pictureInput?.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) {
                previewContainer.style.display = "none";
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Please select a JPG, PNG or WebP image.");
                this.value = "";
                previewContainer.style.display = "none";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Your profile picture must be 5 MB or smaller.");
                this.value = "";
                previewContainer.style.display = "none";
                return;
            }

            preview.src = URL.createObjectURL(file);
            previewContainer.style.display = "block";
        });
    </script>
}

